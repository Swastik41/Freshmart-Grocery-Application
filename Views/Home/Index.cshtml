@model List<FreshMart.Models.Product>

@{
    ViewData["Title"] = "Home";
}

<style>
    /* ---------------- HERO BANNER ---------------- */
    .hero-banner {
        position: relative;
        height: 430px;
        border-radius: 25px;
        overflow: hidden;
        background-image: url('/images/hero-grocery.png'); /* YOUR IMAGE */
        background-size: cover;
        background-position: center;
        box-shadow: 0 10px 25px rgba(0,0,0,0.25);
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
       
        padding-left: 50px;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .hero-overlay h1 {
            font-size: 48px;
            font-weight: 800;
            text-shadow: 0 3px 10px rgba(0,0,0,0.4);
        }

        .hero-overlay p {
            font-size: 20px;
            opacity: 0.95;
        }

    /* Shop Button */
    .hero-btn-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 24px;
    }

    .hero-btn {
        background: linear-gradient(135deg, #7C3AED, #9333EA);
        padding: 14px 40px;
        font-size: 20px;
        font-weight: 700;
        color: #ffffff !important;
        border-radius: 40px;
        text-decoration: none;
        box-shadow: 0 8px 20px rgba(147, 51, 234, 0.35);
        transition: 0.3s ease;
    }

        .hero-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(147, 51, 234, 0.45);
        }


    /* ---------------- FEATURED CATEGORIES ---------------- */
    .product-card {
        border-radius: 20px;
        padding: 25px;
        background: #ffffff;
        text-align: center;
        font-size: 20px;
        font-weight: 600;
        color: #3f3d56;
        transition: 0.25s;
        box-shadow: 0px 8px 20px rgba(147,51,234,0.15);
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0px 14px 28px rgba(147,51,234,0.28);
            background: linear-gradient(135deg, #7C3AED, #9333EA);
            color: #ffffff;
        }

    .section-title {
        font-size: 32px;
        font-weight: 700;
        color: #7C3AED;
        margin-top: 50px;
        margin-bottom: 25px;
    }


    /* ---------------- FEATURED PRODUCTS ---------------- */
    .product-card-premium {
        border-radius: 22px;
        padding: 18px;
        background: #fff;
        box-shadow: 0px 10px 25px rgba(147, 51, 234, 0.15);
        transition: 0.25s;
        text-align: center;
    }

        .product-card-premium:hover {
            transform: translateY(-6px);
            box-shadow: 0px 14px 30px rgba(147, 51, 234, 0.3);
        }

        .product-card-premium img {
            width: 100%;
            height: 160px;
            border-radius: 16px;
            object-fit: cover;
        }

    .price-text {
        font-size: 20px;
        font-weight: 700;
        color: #7C3AED;
    }

    .btn-add {
        background: linear-gradient(135deg, #7C3AED, #9333EA);
        color: #fff;
        border: none;
        margin-top: 8px;
        border-radius: 10px;
        padding: 8px 18px;
        font-weight: 600;
    }

        .btn-add:hover {
            opacity: 0.9;
        }


    /* ---------------- DEALS SECTION ---------------- */
    .deal-banner {
        background: linear-gradient(135deg, #7C3AED, #9333EA);
        padding: 40px;
        border-radius: 22px;
        color: white;
        box-shadow: 0px 12px 30px rgba(147, 51, 234, 0.3);
        margin-top: 60px;
        text-align: center;
    }

        .deal-banner h2 {
            font-size: 32px;
            font-weight: 700;
        }


    /* ---------------- WHY CHOOSE US ---------------- */
    .why-card {
        background: #fff;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0px 10px 25px rgba(147, 51, 234, 0.15);
        text-align: center;
        transition: 0.25s;
    }

        .why-card:hover {
            transform: translateY(-6px);
            box-shadow: 0px 14px 30px rgba(147, 51, 234, 0.25);
        }

    .why-icon {
        font-size: 45px;
        color: #7C3AED;
        margin-bottom: 10px;
    }


    /* ---------------- TESTIMONIALS ---------------- */
    .testimonial-card {
        background: white;
        padding: 25px;
        border-radius: 20px;
        box-shadow: 0px 10px 25px rgba(147,51,234,0.15);
        transition: 0.25s;
    }

        .testimonial-card:hover {
            transform: translateY(-6px);
            box-shadow: 0px 14px 30px rgba(147,51,234,0.25);
        }

    .star {
        color: #facc15;
        font-size: 20px;
    }

    /* PREMIUM PRODUCT CARDS */
    .product-card-premium {
        border-radius: 22px;
        padding: 18px;
        background: #ffffff;
        box-shadow: 0px 10px 25px rgba(147, 51, 234, 0.15);
        transition: 0.35s ease;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .product-card-premium:hover {
            transform: translateY(-8px);
            box-shadow: 0px 18px 40px rgba(147, 51, 234, 0.35);
        }

        .product-card-premium img {
            width: 100%;
            height: 160px;
            border-radius: 16px;
            object-fit: cover;
            transition: transform 0.35s ease;
        }

        .product-card-premium:hover img {
            transform: scale(1.08);
        }

    /* DISCOUNT BADGE */
    .discount-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: #f43f5e;
        color: white;
        padding: 6px 12px;
        font-size: 14px;
        font-weight: 700;
        border-radius: 12px;
    }

    /* PRICE */
    .price-text {
        font-size: 20px;
        font-weight: 700;
        color: #7C3AED;
        margin-top: 5px;
    }

    /* RATING */
    .rating-stars {
        color: #facc15;
        font-size: 18px;
        margin-top: 4px;
    }

    /* ADD TO CART BUTTON */
    .btn-add {
        background: linear-gradient(135deg, #7C3AED, #9333EA);
        color: #fff;
        border: none;
        margin-top: 10px;
        border-radius: 12px;
        padding: 10px 20px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.25s ease;
    }

        .btn-add:hover {
            transform: translateY(-3px);
            box-shadow: 0px 10px 22px rgba(147, 51, 234, 0.45);
        }

    .category-link {
        text-decoration: none;
        color: inherit;
    }

</style>



<!-- ---------------- HERO SECTION ---------------- -->
<div class="hero-banner mb-5">
    <div class="hero-overlay">
        <h1>Fresh Groceries Delivered to Your Doorstep</h1>
        <p>Order fresh fruits, vegetables, dairy products & more</p>

        <div class="hero-btn-wrapper">
            <a href="/Products" class="hero-btn">Shop Now</a>
        </div>
    </div>
</div>



<!-- ---------------- FEATURED CATEGORIES ---------------- -->
<h2 class="section-title">Featured Categories</h2>

<div class="row g-4 text-center">

    <!-- Fruits -->
    <div class="col-md-3">
        <a href="/Products/Category/1" class="category-link">
            <div class="product-card">
                🍎 Fruits
            </div>
        </a>
    </div>

    <!-- Vegetables -->
    <div class="col-md-3">
        <a href="/Products/Category/2" class="category-link">
            <div class="product-card">
                🥦 Vegetables
            </div>
        </a>
    </div>

    <!-- Dairy -->
    <div class="col-md-3">
        <a href="/Products/Category/3" class="category-link">
            <div class="product-card">
                🥛 Dairy
            </div>
        </a>
    </div>

    <!-- Snacks -->
    <div class="col-md-3">
        <a href="/Products/Category/4" class="category-link">
            <div class="product-card">
                🍪 Snacks
            </div>
        </a>
    </div>

</div>



<!-- ---------------- FEATURED PRODUCTS ---------------- -->
<h2 class="section-title">Featured Products</h2>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-3">
            <div class="product-card-premium">

                <img src="~/uploads/@item.ImagePath"
                     alt="@item.Name"
                     class="featured-img"
                     onerror="this.onerror=null; this.src='/images/placeholder.svg'; this.style.backgroundColor='#f3f4f6';" />

                <h5 class="mt-3">@item.Name</h5>

                <div class="rating-stars">⭐ ⭐ ⭐ ⭐ ⭐</div>

                <p class="price-text">$@item.Price</p>

                <a href="/Cart/Add/@item.ProductId" class="btn btn-add">
                    🛒 Add to Cart
                </a>

            </div>
        </div>
    }
</div>



<!-- ---------------- DEALS & OFFERS ---------------- -->
<div class="deal-banner">
    <h2>🔥 Weekly Deals & Discounts</h2>
    <p class="mt-2 fs-5">Save up to 30% on fresh groceries every week!</p>
</div>



<!-- ---------------- WHY CHOOSE US ---------------- -->
<h2 class="section-title">Why Choose Us?</h2>

<div class="row g-4">

    <div class="col-md-4">
        <div class="why-card">
            <div class="why-icon">🚚</div>
            <h5>Fast Delivery</h5>
            <p>We deliver fresh groceries at lightning speed.</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="why-card">
            <div class="why-icon">🥬</div>
            <h5>Fresh Quality</h5>
            <p>Only the best sourced fruits and vegetables.</p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="why-card">
            <div class="why-icon">💳</div>
            <h5>Secure Payments</h5>
            <p>Your payments are safe with encrypted checkout.</p>
        </div>
    </div>

</div>



<!-- ---------------- TESTIMONIALS ---------------- -->
<h2 class="section-title">What Our Customers Say</h2>

<div class="row g-4">

    <div class="col-md-4">
        <div class="testimonial-card">
            <div class="star">⭐ ⭐ ⭐ ⭐ ⭐</div>
            <p>"Amazing quality! Fresh groceries delivered quickly."</p>
            <strong>- Sarah M.</strong>
        </div>
    </div>

    <div class="col-md-4">
        <div class="testimonial-card">
            <div class="star">⭐ ⭐ ⭐ ⭐ ⭐</div>
            <p>"Best grocery service! Always fresh and good prices."</p>
            <strong>- Daniel K.</strong>
        </div>
    </div>

    <div class="col-md-4">
        <div class="testimonial-card">
            <div class="star">⭐ ⭐ ⭐ ⭐ ⭐</div>
            <p>"Love their selection! Will definitely order again."</p>
            <strong>- Priya S.</strong>
        </div>
    </div>

</div>



<!-- ---------------- FOOTER ---------------- -->
<footer class="text-center py-4 mt-5" style="color:#6B7280;">
    © 2025 FreshMart Grocery Store — All Rights Reserved
</footer>
