@model List<FreshMart.Models.Category>

<h2 class="fw-bold text-success mb-4">Manage Categories</h2>

<a href="/AdminCategory/Create" class="btn btn-success mb-3">+ Add Category</a>

<table class="table table-bordered shadow-sm">
    <thead class="table-success">
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th style="width: 150px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.CategoryName</td>
                <td>@c.Description</td>
                <td>
                    <a href="/AdminCategory/Edit/@c.CategoryId" class="btn btn-primary btn-sm">Edit</a>
                    <a href="/AdminCategory/Delete/@c.CategoryId" class="btn btn-danger btn-sm"
                       onclick="return confirm('Are you sure?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
