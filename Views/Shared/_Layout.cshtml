@using Microsoft.AspNetCore.Http

@{
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FreshMart</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <style>
        .nav-purple {
            font-weight: 600;
            color: #4B5563 !important;
            position: relative;
            padding-bottom: 4px;
            transition: color 0.20s ease-in-out;
        }

            .nav-purple:hover {
                color: #7C3AED !important;
            }

            .nav-purple::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 0px;
                height: 2px;
                width: 0%;
                background: #7C3AED;
                transition: width 0.25s ease-in-out;
            }

            .nav-purple:hover::after {
                width: 100%;
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
        <div class="container">

            <a class="navbar-brand fw-bold" href="/" style="font-size: 24px; color:#7C3AED;">
                FreshMart
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">

                    @* -----------------------
       ADMIN LOGGED IN
       ----------------------- *@
                    @if (userRole == "Admin")
                    {
                        <li class="nav-item mx-2">
                            <a class="nav-link nav-purple" href="/Admin/Dashboard">Admin Dashboard</a>
                        </li>

                        <li class="nav-item mx-2 d-flex align-items-center">
                            <span class="fw-bold" style="color:#7C3AED;">Hi, @userName</span>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="btn btn-danger btn-sm" href="/User/Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                        @* -----------------------
           NORMAL CUSTOMER OR NOT LOGGED IN
           ----------------------- *@

                        <li class="nav-item mx-2">
                            <a class="nav-link nav-purple" href="/">Home</a>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="nav-link nav-purple" href="/Products">Products</a>
                        </li>

                        <li class="nav-item mx-2">
                            <a class="nav-link nav-purple" href="/Cart">Cart</a>
                        </li>

                        @if (string.IsNullOrEmpty(userName))
                        {
                            <li class="nav-item mx-2">
                                <a class="nav-link nav-purple" href="/User/Login">Login</a>
                            </li>

                            <li class="nav-item mx-2">
                                <a class="nav-link nav-purple" href="/User/Register">Register</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item mx-2 d-flex align-items-center">
                                <span class="fw-bold" style="color:#7C3AED;">Hi, @userName</span>
                            </li>

                            <li class="nav-item mx-2">
                                <a class="btn btn-danger btn-sm" href="/User/Logout">Logout</a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </nav>


    <!-- BODY -->
    <div class="container mt-4">
        @RenderBody()
    </div>


    <!-- FOOTER -->
    <footer class="bg-white text-center py-3 mt-5 shadow-sm">
        <p class="mb-0 text-muted">
            © 2025 - FreshMart Grocery Store
        </p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)


</body>
</html>
